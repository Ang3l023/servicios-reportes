{
  "name": "Reporte de Servicio",
  "short_name": "Reporte",
  "display": "standalone",
  "start_url": "/",
  "scope": "/",
  "theme_color": "#1e293b",
  "background_color": "#f1f5f9",
  "icons": [
    {
      "src": "assets/icons/icon-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "assets/icons/icon-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "media",
          "accept": [
            "image/*",
            "image/jpeg",
            "image/png",
            "image/webp",
            "image/heic",
            ".jpg",
            ".jpeg",
            ".png",
            ".webp"
          ]
        }
      ]
    }
    }
}
